# Tines MCP Server - Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ==================== Required Configuration ====================

# Your Tines tenant domain (e.g., your-company.tines.com)
TINES_TENANT=your-company.tines.com

# Your Tines API token (get from Tines Settings > API Tokens)
TINES_API_TOKEN=your-api-token-here

# ==================== Optional: API Settings ====================

# Request timeout in seconds (default: 30, max: 120)
# TINES_API_TIMEOUT=30

# ==================== Optional: Security Settings ====================

# Enable rate limiting (default: true)
# TINES_RATE_LIMIT_ENABLED=true

# Requests per minute limit (default: 60)
# TINES_RATE_LIMIT=60

# Enable circuit breaker (default: true)
# TINES_CIRCUIT_BREAKER_ENABLED=true

# Enable audit logging (default: true)
# TINES_AUDIT_ENABLED=true

# Audit log directory (optional, defaults to console only)
# TINES_AUDIT_LOG_PATH=/var/log/tines-mcp

# Log level: DEBUG, INFO, WARNING, ERROR (default: WARNING)
# TINES_LOG_LEVEL=WARNING

# ==================== Optional: Secrets Manager ====================
# Choose one secrets manager backend (default: env)

# Secrets manager: env, vault, aws, azure
# SECRETS_MANAGER=env

# HashiCorp Vault settings
# VAULT_ADDR=https://vault.your-company.com
# VAULT_TOKEN_PATH=/run/secrets/vault-token
# VAULT_SECRET_PATH=secret/data/tines

# AWS Secrets Manager settings
# AWS_SECRETS_REGION=us-east-1
# AWS_SECRET_NAME=tines/api-credentials

# Azure Key Vault settings
# AZURE_KEYVAULT_URL=https://your-vault.vault.azure.net
